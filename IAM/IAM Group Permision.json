{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "IAMManageProjectRolesOnly",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:DeleteRole",
				"iam:GetRole",
				"iam:UpdateRole",
				"iam:AttachRolePolicy",
				"iam:DetachRolePolicy",
				"iam:PutRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:GetRolePolicy",
				"iam:ListRolePolicies",
				"iam:ListAttachedRolePolicies",
				"iam:TagRole",
				"iam:CreateInstanceProfile",
				"iam:DeleteInstanceProfile",
				"iam:GetInstanceProfile",
				"iam:AddRoleToInstanceProfile",
				"iam:RemoveRoleFromInstanceProfile"
			],
			"Resource": [
				"arn:aws:iam::257074875139:role/EC2-cloudops-role",
				"arn:aws:iam::257074875139:role/noc-remediation-role",
				"arn:aws:iam::257074875139:instance-profile/EC2-cloudops-profile"
			]
		},
		{
			"Sid": "IAMPassRoleForThisProjectOnly",
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": [
				"arn:aws:iam::257074875139:role/EC2-cloudops-role",
				"arn:aws:iam::257074875139:role/noc-remediation-role"
			]
		},
		{
			"Sid": "IAMReadOnlyForConsoleBrowsing",
			"Effect": "Allow",
			"Action": [
				"iam:ListRoles",
				"iam:ListPolicies",
				"iam:ListInstanceProfiles",
				"iam:GetPolicy",
				"iam:GetPolicyVersion"
			],
			"Resource": "*"
		},
		{
			"Sid": "EC2InstanceLifecycle",
			"Effect": "Allow",
			"Action": [
				"ec2:RunInstances",
				"ec2:TerminateInstances",
				"ec2:StartInstances",
				"ec2:StopInstances",
				"ec2:RebootInstances",
				"ec2:DescribeInstances",
				"ec2:DescribeImages",
				"ec2:DescribeInstanceTypes",
				"ec2:DescribeKeyPairs",
				"ec2:CreateKeyPair",
				"ec2:DeleteKeyPair",
				"ec2:CreateTags",
				"ec2:AssociateIamInstanceProfile",
				"ec2:DescribeIamInstanceProfileAssociations"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-south-1"
				}
			}
		},
		{
			"Sid": "VPCNetworkingForThisProject",
			"Effect": "Allow",
			"Action": [
				"ec2:CreateVpc",
				"ec2:DeleteVpc",
				"ec2:DescribeVpcs",
				"ec2:CreateSubnet",
				"ec2:DeleteSubnet",
				"ec2:DescribeSubnets",
				"ec2:CreateInternetGateway",
				"ec2:AttachInternetGateway",
				"ec2:DetachInternetGateway",
				"ec2:DeleteInternetGateway",
				"ec2:CreateRouteTable",
				"ec2:DeleteRouteTable",
				"ec2:CreateRoute",
				"ec2:AssociateRouteTable",
				"ec2:DisassociateRouteTable",
				"ec2:CreateSecurityGroup",
				"ec2:DeleteSecurityGroup",
				"ec2:AuthorizeSecurityGroupIngress",
				"ec2:AuthorizeSecurityGroupEgress",
				"ec2:RevokeSecurityGroupIngress",
				"ec2:RevokeSecurityGroupEgress",
				"ec2:DescribeSecurityGroups"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-south-1"
				}
			}
		},
		{
			"Sid": "CloudWatchAlarmsAndDashboards",
			"Effect": "Allow",
			"Action": [
				"cloudwatch:PutDashboard",
				"cloudwatch:GetDashboard",
				"cloudwatch:ListDashboards",
				"cloudwatch:DeleteDashboards",
				"cloudwatch:PutMetricAlarm",
				"cloudwatch:DeleteAlarms",
				"cloudwatch:DescribeAlarms",
				"cloudwatch:DescribeAlarmHistory",
				"cloudwatch:ListMetrics",
				"cloudwatch:GetMetricData",
				"cloudwatch:GetMetricStatistics"
			],
			"Resource": "*"
		},
		{
			"Sid": "CloudWatchLogsReadForTroubleshooting",
			"Effect": "Allow",
			"Action": [
				"logs:DescribeLogGroups",
				"logs:DescribeLogStreams",
				"logs:GetLogEvents",
				"logs:FilterLogEvents"
			],
			"Resource": "arn:aws:logs:ap-south-1:257074875139:log-group:*"
		},
		{
			"Sid": "SNSForThisTopicOnly",
			"Effect": "Allow",
			"Action": [
				"sns:CreateTopic",
				"sns:DeleteTopic",
				"sns:Subscribe",
				"sns:Unsubscribe",
				"sns:Publish",
				"sns:GetTopicAttributes",
				"sns:SetTopicAttributes",
				"sns:ListSubscriptionsByTopic"
			],
			"Resource": "arn:aws:sns:ap-south-1:257074875139:cloudops-sns"
		},
		{
			"Sid": "SNSAccountWideListActions",
			"Effect": "Allow",
			"Action": [
				"sns:ListTopics",
				"sns:ListSubscriptions"
			],
			"Resource": "*"
		},
		{
			"Sid": "LambdaForThisFunctionOnly",
			"Effect": "Allow",
			"Action": [
				"lambda:CreateFunction",
				"lambda:UpdateFunctionCode",
				"lambda:UpdateFunctionConfiguration",
				"lambda:DeleteFunction",
				"lambda:GetFunction",
				"lambda:InvokeFunction",
				"lambda:AddPermission",
				"lambda:RemovePermission",
				"lambda:GetPolicy"
			],
			"Resource": "arn:aws:lambda:ap-south-1:257074875139:function:noc-auto-remediation"
		},
		{
			"Sid": "EC2InstanceConnectForBrowserSSH",
			"Effect": "Allow",
			"Action": "ec2-instance-connect:SendSSHPublicKey",
			"Resource": "arn:aws:ec2:ap-south-1:257074875139:instance/i-0b7d483631875bb1c"
		},
		{
			"Sid": "SSMConsoleListingActionsRequireWildcard",
			"Effect": "Allow",
			"Action": [
				"ssm:DescribeInstanceInformation",
				"ssm:ListCommands",
				"ssm:GetCommandInvocation",
				"ssm:GetInventory",
				"ssm:UpdateInstanceInformation",
				"ssm:ListInventoryEntries",
				"ssm:DescribeInstancePatchStates",
				"ssm:DescribeInstancePatchStatesForPatchGroup",
				"ssm:DescribeAutomationExecutions",
				"tag:GetResources"
			],
			"Resource": "*"
		},
		{
			"Sid": "SSMForThisInstanceOnly",
			"Effect": "Allow",
			"Action": [
				"ssm:SendCommand",
				"ssm:StartSession"
			],
			"Resource": [
				"arn:aws:ec2:ap-south-1:257074875139:instance/i-0b7d483631875bb1c",
				"arn:aws:ssm:ap-south-1::document/AWS-RunShellScript",
				"arn:aws:ssm:ap-south-1::document/SSM-SessionManagerRunShell",
				"arn:aws:ssm:ap-south-1:257074875139:*"
			]
		}
	]
}
